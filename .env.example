# === Facebook App 信息（如需 OAuth 授权流程可用，当前面板走系统用户令牌，非必填）===
FB_APP_ID=
FB_APP_SECRET=

# Graph API 版本
FB_API_VERSION=v20.0

# === 面板登录（账号 + 密码）===
# 这一个账号会在每次启动时自动同步成"超级管理员"（is_admin=True，免审核）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
# 用于签发登录 JWT 的密钥，务必改成一串随机字符串
JWT_SECRET=change_me_to_a_random_long_string

# SQLite 数据库文件路径（容器内，已通过 volume 持久化到宿主机 ./data）
DATABASE_URL=sqlite:////app/data/panel.db

# 说明1：各 Meta Business Manager 的系统用户长效令牌不放在这里，
# 部署完成后用管理员账号登录，在「BM账号管理」页面里逐个添加（只需粘贴令牌，
# BM 名称和 ID 会自动识别）。

# 说明2：除了上面这个管理员账号，其他人通过登录页的"注册"入口自己申请账号，
# 默认是待审核状态、看不到任何广告账户；管理员登录后到「用户管理」页面审核通过，
# 再给这个用户分配具体能看哪些 BM / 广告账户。
