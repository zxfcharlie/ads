# === Facebook App 信息（在 developers.facebook.com 创建应用后获取）===
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret

# 长效系统用户令牌（System User Token），需具备权限：
# ads_management, ads_read, business_management
FB_ACCESS_TOKEN=your_long_lived_system_user_token

# Graph API 版本
FB_API_VERSION=v20.0

# 面板登录口令（简单保护，非公网直接暴露）
PANEL_PASSWORD=change_me

# SQLite 数据库文件路径（容器内）
DATABASE_URL=sqlite:////app/data/panel.db
